{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-radar-pod",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel-radar-pod-db",
      "database_id": "06e105f6-a90f-4bb8-9520-3a251b359c00"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "FACTORY_HUB",
      "service": "factory-hub"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
